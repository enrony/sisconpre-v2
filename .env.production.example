# Plantilla de .env para producción — VPS Ferozo (prestamos.gilensoft.com)
# Copiar a .env en el servidor y completar. NO commitear el .env real.

APP_NAME="Prestamos GILEN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://prestamos.gilensoft.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gilen_prestamos
DB_USERNAME=gilen_prestamos
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis disponible en lsphp83; usar si la cuenta lo permite
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo: 'log' hasta tener SMTP real
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@gilensoft.com"
MAIL_FROM_NAME="${APP_NAME}"

# Segundo mailer del sistema legado (completar en Fase 8 si sigue en uso)
# MAIL_HOST_2=
# MAIL_PORT_2=
# MAIL_USERNAME_2=
# MAIL_PASSWORD_2=

# Almacenamiento S3 para soportes de pago (Fase 8)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
