# Plantilla de .env para producción — VPS Ferozo (prestamos.gilensoft.com)
# Copiar a .env en el servidor y completar. NO commitear el .env real.

APP_NAME="Prestamos GILEN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://prestamos.gilensoft.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gilen_prestamos
DB_USERNAME=gilen_prestamos
DB_PASSWORD=

# BD de tests (php artisan test → phpunit.xml usa `prestamos_gilen_test`).
# Crear una vez si se corren pruebas en el server: CREATE DATABASE prestamos_gilen_test;

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Sin broadcasting (no se usa Pusher/Echo).
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `database` no requiere servicios extra. Redis disponible en lsphp83:
# QUEUE_CONNECTION=redis / CACHE_STORE=redis si la cuenta lo permite.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo: 'log' hasta tener SMTP real de la cuenta Ferozo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@gilensoft.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP secundario para correos a clientes (RecargoMail). Vacío = usa el principal;
# poner MAIL_NOTIFICATIONS_MAILER=smtp2 para enrutarlos por aquí.
MAIL_NOTIFICATIONS_MAILER=
MAIL_HOST_2=
MAIL_PORT_2=587
MAIL_USERNAME_2=
MAIL_PASSWORD_2=
MAIL_SCHEME_2=
MAIL_FROM_ADDRESS_2=
MAIL_FROM_NAME_2=

# S3 no se usa (soportes en disco local). Completar solo si se migran a S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
